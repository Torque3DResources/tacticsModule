//-----------------------------------------------------------------------------
// PlayGui is the main TSControl through which the game is viewed.
// The PlayGui also contains the hud controls.
//-----------------------------------------------------------------------------

function tacticsGameMode::Playgui_onWake(%this)
{
   echo("tacticsGameMode::Playgui_onWake");
   
   //get rid of this thing so we can have the canvas to ourself
   Canvas.popDialog(DamageGuiOverlay);
   
   //get rid of the standard FPSPlayer keymap too
   //we will keep ExampleMoveMap if it has been loaded, but only as a backup
   if(isObject("playerKeyMap"))
      playerKeyMap.pop();
      
   tacticsMoveMap.push();
   
   //display the tactics StartUp file
   Canvas.pushDialog(tacticsStartGui);
}

function tacticsGameMode::Playgui_onSleep(%this)
{
   tacticsMoveMap.pop();
   Canvas.popDialog(tacticsOverlayGui);
   Canvas.popDialog(tacticsStartGui);
   Canvas.popDialog(tacticsGameOverGui);
}

function tacticsGameMode::Playgui_clearHud( %this )
{
    Canvas.popDialog(tacticsOverlayGui);
}

function Playgui::onMouseDown(%this, %screenPos, %worldPos, %vector)
{
   echo("tacticsGameMode::Playgui_onMouseDown");
   //as we don't know locally what the state of the turn is -
   //(we do really, it's a singlePlayer experience but we are not cutting corners)
   //we need to send this data to the server and let the game sort it out
   
   commandToServer('onClientMouseDown', %worldPos, %vector);
}

function Playgui::onRightMouseDown(%this, %screenPos, %worldPos, %vector)
{
   echo("tacticsGameMode::Playgui_onRightMouseDown - toggle cursor");
   
   //let the server decide whether we can toggle the cursor on or off
   //to prevent client input disrupting game turns
   commandToServer('ServerToggleCursor');
}
