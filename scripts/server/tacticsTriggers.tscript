function activateTriggerEnd(%trig, %obj)
{
   //if we passed the trigger we may wish to deactivate it
   if(isObject(%trig))
      %trig.disableTrig = 1;
      
   //win! team1 wins if they get here
   echo("\c1activateTriggerEnd successful - game ends in victory!");
   
   %client = %obj.teamClient;
   if(!isObject(%client))
      error("activateTriggerEnd has been activated by " @ %obj SPC %obj.getName() @ " but it has no teamClient!");
   else
   {
      //tell the client to display the game over screen
      %result = "Victory!";
      messageClient(%client, 'MsgGameOver', '\c3GAME OVER - Player %1', %result);
      
      commandToClient(%client, 'TacticsDemoGameOver', "Victory!", "You Reached The Level Exit!");
   }   
}
