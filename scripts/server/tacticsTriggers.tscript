//this is for trigger tripping tests and trigger functions,

//an overall test that it is the Player Team doing the tripping
function triggerTestPlayerTeam(%obj)
{
   echo("trigger test against obj " @ %obj.getId()); 
   if(%obj.team == 1)
   {
      echo("team is player team");
      return true;
   }
   else
      echo("team is NOT player team - ignore");
      
   return false;
}

//function for starting the game and spawning initial players called from
function activateInitTacticsGame()
{
   %bot1 = spawn1.spawnObject("");
   %bot2 = spawn2.spawnObject("");
   %bot3 = spawn3.spawnObject("");
   
   %bot1.setName("ally1");
   %bot2.setName("ally2");
   %bot3.setName("ally3");
   echo("activateInitGame spawns " @ %bot1 SPC %bot1.getName() SPC %bot2 SPC %bot2.getName() SPC %bot3 SPC %bot3.getName());
   
   //team is set on the spawnSphere spawnScript and tacticsEquip is also called from there
   /*%bot1.tacticsEquip(%bot1.team);
   %bot2.tacticsEquip(%bot2.team);
   %bot3.tacticsEquip(%bot3.team);*/
}

//functions for tripping triggers in the level, %trig is trigger, %obj is ai/player object that tripped it

function activateTriggerStart(%trig, %obj)
{
   //if we passed the trigger we may wish to deactivate it
   if(isObject(%trig))
      %trig.disableTrig = 1;
      
   //spawn an enemy - team, setSkinName and moveTo data are in the spawnSphere's spawnScript function
   //but they could also be scripted here eg: %bot.team=2; %bot.setSkinName(Yellow);
   
   //we can take care of all other things here
   %bot = spawn4.spawnObject("");//
   echo("activateTriggerStart has spawned AiPlayer " @ %bot);
   %bot.tacticsEquip(%bot.team);
   %bot.setName("enemy1");
}

function activateTrigger1(%trig, %obj)
{
   //if we passed the trigger we may wish to deactivate it
   if(isObject(%trig))
      %trig.disableTrig = 1;
      
   //spawn an enemy - team, setSkinName and moveTo data are in the spawnSphere's spawnScript function
   //but they could also be scripted here eg: %bot.team=2; %bot.setSkinName(Yellow);
   
   //we can take care of all other things here
   %bot = spawn5.spawnObject("");//this guy will run in when it is his turn
   echo("activateTrigger1 has spawned AiPlayer " @ %bot);
   %bot.tacticsEquip(%bot.team);
   %bot.setName("enemy2");
   
   %bot2 = spawn6.spawnObject("");//this guy will hide down the side and try to ambush
   echo("activateTrigger1 has spawned AiPlayer " @ %bot2);
   %bot2.tacticsEquip(%bot2.team);
   %bot2.setName("enemy3");
   
   %bot3 = spawn8.spawnObject("");//this guy will hold position round the corner
   echo("activateTrigger1 has spawned AiPlayer " @ %bot3);
   %bot3.tacticsEquip(%bot3.team);
   %bot3.setName("enemy4");
   
}

