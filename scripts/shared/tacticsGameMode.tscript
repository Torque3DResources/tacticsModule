//This file implements game mode logic for an Example gamemode. The primary functions:
//tacticsGameMode::onMissionStart
//tacticsGameMode::onMissionReset
//tacticsGameMode::onMissionEnd
//Are the primary hooks for the server to start, restart and end any active gamemodes
//onMissionStart, for example is called from core/clientServer/scripts/server/levelLoad.cs
//It's called once the server has successfully loaded the level, and has parsed
//through any active scenes to get GameModeNames defined by them. It then iterates
//over them and calls these callbacks to envoke gamemode behaviors. This allows multiple
//gamemodes to be in effect at one time. Modules can implement as many gamemodes as you want.
//
//For levels that can be reused for multiple gammodes, the general setup would be a primary level file
//with the Scene in it having the main geometry, weapons, terrain, etc. You would then have subScenes that
//each contain what's necessary for the given gamemode, such as a subScene that just adds the flags and capture
//triggers for a CTF mode. The subscene would then have it's GameModeName defined to run the CTF gamemode logic
//and the levelLoad code will execute it.

if(!isObject(tacticsGameMode))
{
    new GameMode(tacticsGameMode){};
}

//This function is called when the level finishes loading. It sets up the initial configuration, variables and
//spawning and dynamic objects, timers or rules needed for the gamemode to run
function tacticsGameMode::onMissionStart(%this)
{
   echo("\c4tacticsGameMode::onMissionStart " @ %this);
   
   //set up the game and game variables
   %this.initGameVars();

   if (%this.isActive())
   {
      error("scriptERROR tacticsGameMode::onMissionStart: End the game first!");
      return;
   }
      
   %this.setActive(true);
}

//This function is called when the level ends. It can be envoked due to the gamemode ending
//but is also kicked off when the game server is shut down as a form of cleanup for anything the gamemode
//created or is managing like the above mentioned dynamic objects or timers
function tacticsGameMode::onMissionEnded(%this)
{
   if (!%this.isActive())
   {
      error("scriptERROR tacticsGameMode::onMissionEnded: No game running!");
      return;
   }

   %this.setActive(false);
}

//This function is called in the event the server resets and is used to re-initialize the gamemode
function tacticsGameMode::onMissionReset(%this)
{
   // Called by resetMission(), after all the temporary mission objects
   // have been deleted.
   %this.initGameVars();
}

//This sets up our gamemode's duration time
function tacticsGameMode::initGameVars(%this)
{
   echo("\c4tacticsGameMode::initGameVars " @ %this);
   
   // Set the gameplay parameters
   %this.duration = 20;//we don't use game duration in time, we use it as maximum in turns
   
   %this.teamPhase = 0;//which team is currently active; we always start with team 1
   %this.curTurn = 0;//start at turn zero and increment when a new turn starts
   %this.activePlayer = 0;//the ai/player who is currently in action
   %this.busy = 0;//if something is happening and we want to ignore player inputs
    
   %this.team1CamTarget = 0;//current player the client cam is set to
   %this.team2CamTarget = 0;//current player the CPU/Ai cam is set to
   %this.team1Client = 0;//this will be replaced with the human client object
   %this.team2Client = 0;//this will be left as zero, and the CPU/Ai will control the team
   
   //decal being a visual identification of the position our current controlled player is moving to
   //%newDecal = decalManagerAddDecal( %pos, %norm, 0, 1, "move_decal", true );
   //decalManagerRemoveDecal(%decal);
   %this.decal = -1;//the marker for player movement
   
   //NOTE! if AiPlayer's exist via "autoSpawn" from their spawnSphere settings, 
   //they will exist before the teamLists are created here, so avoid doing that
   
   //player team 1 arrayObject
   if(!isObject(team1List))
   {
      %list1 = new ArrayObject("team1List");
      MissionCleanup.add(%list1);
      echo("tacticsGameMode::onMissionStart create team1List " @ %list1);
   }
   else
   {
      %list1 = team1List.getId();
      %list1.empty();
      error("scriptERROR WARNING tacticsGameMode::initGameVars team1List " @ %list1 @ " already exists - empty");
   }
   
   //Ai team 2 arrayObject
   if(!isObject(team2List))
   {
      %list2 = new ArrayObject("team2List");
      MissionCleanup.add(%list2);
      echo("tacticsGameMode::onMissionStart create team2List " @ %list2);
   }
   else
   {
      %list2 = team2List.getId();
      %list2.empty();
      error("scriptERROR WARNING tacticsGameMode::initGameVars team2List " @ %list2 @ " already exists");
   }
   
   //activate the starting part of the game, in this case spawning 3 team1 players
   activateInitTacticsGame();
}

//we don't use game duration in time, if we did it would probably be a maximum in turns
//This is called when the timer runs out, allowing the gamemode to end
function tacticsGameMode::onGameDurationEnd(%this)
{
   //we don't end if we're currently editing the level
   if (%this.duration && !(EditorIsActive() && GuiEditorIsActive()))
      %this.onMissionEnded();
}

//This is called to actually spawn a control object for the player to utilize
//A player character, spectator camera, etc.
function tacticsGameMode::spawnControlObject(%this, %client)
{
   echo("\c4tacticsGameMode::spawnControlObject " @ %this @ " client " @ %client);
   //In this example, we just spawn a camera
   if (!isObject(%client.camera))
   {
      if(!isObject(Observer))
      {
         datablock CameraData(Observer)
         {
            mode = "Observer";
         };  
      }
      
      %client.camera = spawnObject("Camera", Observer);
   }
   else
      echo("\c1tacticsGameMode::spawnControlObject client " @ %client @ " has camera " @ %client.camera);

   // If we have a camera then set up some properties
   if (isObject(%client.camera))
   {
      MissionCleanup.add( %this.camera );
      %client.camera.scopeToClient(%client);

      %client.setControlObject(%client.camera);

      %client.camera.setTransform("0 0 1 0 0 0 0");
   }
   else
      echo("\c1tacticsGameMode::spawnControlObject client " @ %client @ " set properties for camera " @ %client.camera);
   
}

//This is called when the client has finished loading the mission, but aren't "in" it yet
//allowing for some last-second prepwork
function tacticsGameMode::onClientMissionLoaded(%this)
{
    $clientLoaded++;
    if ($clientLoaded == $clientConneted)
        $gameReady = true;
}

//This is called when the client has initially established a connection to the game server
//It's used for setting up anything ahead of time for the client, such as loading in client-passed
//config stuffs, saved data or the like that should be handled BEFORE the client has actually entered
//the game itself
function tacticsGameMode::onClientConnect(%this, %client)
{
    $clientConneted++;
    getPlayer(%client);
}

   
//This is called when a client enters the game server. It's used to spawn a player object
//set up any client-specific properties such as saved configs, values, their name, etc
//These callbacks are activated in core/clientServer/scripts/server/levelDownload.cs
function tacticsGameMode::onClientEnterGame(%this, %client)
{
   echo("\c4tacticsGameMode::onClientEnterGame " @ %this @ " client " @ %client @ " $Game::DefaultCameraSpawnGroups " @ $Game::DefaultCameraSpawnGroups);

   // Inform the client of all the other clients
   %count = ClientGroup.getCount();
   for (%cl = 0; %cl < %count; %cl++)
   {
      %other = ClientGroup.getObject(%cl);
      if ((%other != %client))
      {
         // These should be "silent" versions of these messages...
         messageClient(%client, 'MsgClientJoin', "",
            %other.playerName,
            %other,
            %other.sendGuid,
            %other.team,
            %other.score,
            %other.kills,
            %other.deaths,
            %other.isAIControlled(),
            %other.isAdmin,
            %other.isSuperAdmin);
      }
   }

   // Inform the client we've joined up
   messageClient(%client,
      'MsgClientJoin', '\c4Welcome to the Torque demo app %1.',
      %client.playerName,
      %client,
      %client.sendGuid,
      %client.team,
      %client.score,
      %client.kills,
      %client.deaths,
      %client.isAiControlled(),
      %client.isAdmin,
      %client.isSuperAdmin);

   // Inform all the other clients of the new guy
   messageAllExcept(%client, -1, 'MsgClientJoin', '\c1%1 joined the game.',
      %client.playerName,
      %client,
      %client.sendGuid,
      %client.team,
      %client.score,
      %client.kills,
      %client.deaths,
      %client.isAiControlled(),
      %client.isAdmin,
      %client.isSuperAdmin);
   
   if(!isObject(%this.team1Client))//this will be replaced with the human client object
   {
      %this.team1Client = %client;
      
      //make sure we update the team player lists if need be
      if(!isObject(team1List))
         error("scriptERROR tacticsGameMode::onClientEnterGame " @ %this @ " client enters game " @ %client @ " team1List does not exist!");
      else
      {
         %list = team1List.getId();
         %count = %list.count();//*.getCount(); for simgroups/simsets - *.count(); for arrays
         if(%count > 0)
         {
            for(%i=0; %i < %count; %i++)
            {
               %key = %list.getKey(%i);
               if(isObject(%key))
                  %key.teamClient = %client;
               else
                  error("scriptERROR tacticsGameMode::onClientEnterGame " @ %this @ " client enters game " @ %client @ " team1List " @ %list @ " has non-existant key at index " @ %i);
            }            
         }
      }
   }
   else
      error("scriptERROR tacticsGameMode::onClientEnterGame " @ %this @ " client enters game " @ %client @ " but team1Client already exists! " @ %this.team1Client);

   //Spawn NPCs for the map and stuff here?

   // This function currently relies on some helper functions defined in
   // core/scripts/spawn.cs. For custom spawn behaviors one can either
   // override the properties on the SpawnSphere's or directly override the
   // functions themselves.
   %spawnPoint = pickCameraSpawnPoint($Game::DefaultCameraSpawnGroups);
   %client.spawnCamera(%spawnPoint);
}

