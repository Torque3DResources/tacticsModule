//This is called when the player leaves the game server. It's used to clean up anything that
//was spawned or setup for the client when it connected, in onClientEnterGame
//These callbacks are activated in core/clientServer/scripts/server/levelDownload.cs
function tacticsGameMode::onClientLeaveGame(%this, %client)
{
    // Cleanup the camera
   if (isObject(%this.camera))
      %this.camera.delete();
   // Cleanup the player
   if (isObject(%this.player))
      %this.player.delete();
}

//-----------------------------------------------------------------------------
// Functions that implement game-play
// These are here for backwards compatibilty only, games and/or mods should
// really be overloading the server and mission functions listed ubove.
//-----------------------------------------------------------------------------

//-----------------------------------------------------------------------------
// pickPlayerSpawnPoint() is responsible for finding a valid spawn point for a
// player.
//-----------------------------------------------------------------------------
function tacticsGameMode::pickPlayerSpawnPoint(%this, %i)
{
    echo("\c4tacticsGameMode::pickPlayerSpawnPoint " @ %i);
    
   // Didn't find a spawn point by looking for the groups
   // so let's return the "default" SpawnSphere
   // First create it if it doesn't already exist
   if (!isObject(DefaultPlayerSpawnSphere))
   {
      %spawn = new SpawnSphere(DefaultPlayerSpawnSphere)
      {
         dataBlock      = "SpawnSphereMarker";
         radius = 1;
      };

      // Add it to the MissionCleanup group so that it
      // doesn't get saved to the Mission (and gets cleaned
      // up of course)
      MissionCleanup.add(%spawn);
   }
   
   return DefaultPlayerSpawnSphere;
}

function tacticsGameMode::setSpawnPoint(%this, %client)
{
   echo("\c4tacticsGameMode::setSpawnPoint client " @ %client);
   // Find a spawn point for the player
   // This function currently relies on some helper functions defined in
   // core/scripts/spawn.cs. For custom spawn behaviors one can either
   // override the properties on the SpawnSphere's or directly override the
   // functions themselves.
   %spawnPoint = %this.pickPlayerSpawnPoint(%client.player);
   if(isObject(%spawnPoint))
   {
      %client.SpawnLocation = %spawnPoint.getTransform();
      %this.setSpawnPointComplete(%client);
   }
   else
   {
      %this.setSpawnPointFailed(%client);
   }
}

function tacticsGameMode::setSpawnPointComplete(%this, %client)
{
   echo("\c4tacticsGameMode::setSpawnPointComplete client " @ %client);
   //Fire the signal that we are, in fact, fully finished
   %client.GetEventManager().postEvent( "setSpawnPointComplete", %client );
}

function tacticsGameMode::setSpawnPointFailed(%this, %client)
{
   error("scriptERROR tacticsGameMode::setSpawnPointFailed client " @ %client);
   //Fire the signal that we are, in fact, fully finished
   %client.GetEventManager().postEvent( "setSpawnPointFailed", %client );
}

function tacticsGameMode::onPostSpawn(%this, %client)
{   
   echo("\c4tacticsGameMode::onPostSpawn " @ %client);

   %this.spawnTacticsCam(%client);//this will also kick start the game
   %client.getEventManager().postEvent("postSpawnComplete",%client);
}

// ----------------------------------------------------------------------------
// Make sure we have an Observer camera and start the game
// ----------------------------------------------------------------------------

function tacticsGameMode::spawnTacticsCam(%this, %client)
{
   echo("\c4tacticsGameMode::spawnTacticsCam client " @ %client);
   if (!isObject(%client.camera))
   {
      %client.camera = new camera(){ datablock = "tacticsCam"; };
   }
   
   //echo (%game @"\c4 -> "@ %game.class @" -> GameCore::spawnObserver");
   if(%client.player)
   {
      %transform = %client.player.getTransform();
      %client.camera.setTransform(%transform);
      %client.camera.setOrbitMode(%client.player, %transform, 0.5, 4.5, 4.5);
   }
   else
   {
      %client.camera.setFlyMode();
      echo("no client player");
   }
   
   // Set control to the camera
   %client.setControlObject(%client.camera);
   %client.camera.scopeToClient(%client);
   
   //and give us our first team member of team1List
   %this.controlInitialTeamMember(%client, team1List);
}

//we are expecting Team 1 to be the player team, and Team 2 to be the CPU/bot team
//so this function will only affect the player team team 1 with team1List
function tacticsGameMode::controlInitialTeamMember(%this, %client, %list)
{
   //while we are at it modify the time health patches expire as they fade out too fast for turnbased gameplay
   //make it so long they won't respawn or get deleted
   $Item::PopTime = 10000 * 10000;
   $Item::RespawnTime = 10000 * 10000;
   
   //do we have a prespawned player created via FPSPlayer module?
   //if so get rid of it
   if(isObject(%client.player))
   {
      echo("\c2tacticsGameMode::controlInitialTeamMember delete client player - this is not FPS gameplay");
      //it needs a pause to complete spawn callbacks
      %client.player.schedule(3000, "delete");
   }
   
   if(isObject(%list))
   {
      %count = %list.count();//simsets/simgroups have .getCount();, arrays have .count();
      if(%count > 0)
      {
         //get the first team member
         %obj = %list.getKey(0);
         if(isObject(%obj))
         {
            //Camera::setOrbitObject(GameBase orbitObject, VectorF rotation, float minDistance, float maxDistance, float initDistance, bool ownClientObject=false, Point3F offset=Point3F::Zero, bool locked=false)
            %trans = %obj.getTransform();
            %posneg = getword(%trans, 5);
            %deg = getword(%trans, 6);
            if(%posneg < 0)
            {
               //echo("posneg is negative " @ %posneg);
               %deg = %deg - %deg - %deg;
            }
            %client.camera.setOrbitObject(%obj, "0.349 0 " @ %deg, 1, 5, 5, 0, "0 0 1", 0);//"0.523599 0 " @ %deg
      
            %this.activePlayer = %obj;
            %this.curTurn = 1;//start the game!
            %this.teamPhase = 1;//team1 phase, the client player
            
            %obj.moveShootMode = 0;//move, not shoot
            %obj.shotThisTurn = 0;//one burst fire per turn
            %obj.turnComplete = 0;//only for Ai/CPU team
            
            //we now need to update everything the player can see
            %health = 100 - (100 * %obj.getDamagePercent());//display it as percentage
            %health = mFloor(%health);//no decimals please
            %energy = %obj.getEnergyLevel();
            
            %wpn = %obj.getMountedImage(0);//notice hardcoded imageSlot
            if(%wpn)
               %preview = %wpn.item.previewImage;
            else
               %preview = "";
               
            %turn = %this.curTurn @ " / " @ %this.duration;
            commandToClient(%client, 'UpdateHudDataDisplay', %health, %energy, %preview, false, %turn, %count); 
            
            //let the player/client know that we are starting the game!
            %faction = "Player";
            messageAll('MsgTurnPhase', '\c3Turn %1: %2 Phase', %this.curTurn, %faction);
         }
         else
            error("scriptERROR controlInitialTeamMember client " @ %client @ " for team list " @ %list @ " key at index 0 is not an object " @ %obj);
      }
      else
         error("scriptERROR controlInitialTeamMember client " @ %client @ " finds no team members for team list " @ %list);
   }
   else
      error("scriptERROR controlInitialTeamMember client " @ %client @ " finds no team list for " @ %list);
}

function tacticsGameMode::startNewTurn(%this, %client, %list)
{
   %turn = %this.curTurn;
   %turn++;
   %this.curTurn = %turn;
   %this.teamPhase = 1;//1 for player, 2 for Ai/CPU team
   
   %duration = %this.duration;
   
   //client player's who are killed during the enemy phase are removed from team1List upon death
   //check that we still have some players alive for the client to use otherwise end the game in defeat
   %count = %list.count();//array.count(); simgroup/simset.getCount();
   
   if(%turn > %duration || %count < 1)
   {
      //the player has run out of time
      //tell the client to display the game over screen
      %result = "Defeat!";
      messageClient(%client, 'MsgGameOver', '\c3GAME OVER - Player %1', %result);
      
      if(%count < 1)
         %reason = "All Team Mates Killed! RIP";
      else
         %reason = "Time Has Ran Out!";
         
      commandToClient(%client, 'TacticsDemoGameOver', %result, %reason);
      return;
   }
   
   //let the player/client know that we are starting the game!
   %faction = "Player";
   messageAll('MsgTurnPhase', '\c3Turn %1: %2 Phase', %turn, %faction);
   
   //get the first team member
   %obj = %list.getKey(0);
   if(isObject(%obj))
   {
      //Camera::setOrbitObject(GameBase orbitObject, VectorF rotation, float minDistance, float maxDistance, float initDistance, bool ownClientObject=false, Point3F offset=Point3F::Zero, bool locked=false)
      %trans = %obj.getTransform();
      %posneg = getword(%trans, 5);
      %deg = getword(%trans, 6);
      if(%posneg < 0)
         %deg = %deg - %deg - %deg;
      %client.camera.setOrbitObject(%obj, "0.349 0 " @ %deg, 1, 5, 5, 0, "0 0 1", 0);//"0.523599 0 " @ %deg
      
      %this.activePlayer = %obj;

      %obj.moveShootMode = 0;//move, not shoot
      %obj.shotThisTurn = 0;//one burst fire per turn
      %obj.turnComplete = 0;//only for Ai/CPU team
            
      //we now need to update everything the player can see
      %health = 100 - (100 * %obj.getDamagePercent());//display it as percentage
      %health = mFloor(%health);//no decimals please
      %energy = %obj.getEnergyLevel();
            
      %wpn = %obj.getMountedImage(0);//notice hardcoded imageSlot
      if(%wpn)
         %preview = %wpn.item.previewImage;
      else
         %preview = "";
         
      %turn = %this.curTurn @ " / " @ %this.duration;
      commandToClient(%client, 'UpdateHudDataDisplay', %health, %energy, %preview, false, %turn, %count); 
      
      //clear our aim incase we were shooting in the passive phase
      %obj.clearAim();
   }
   else
      error("scriptERROR tacticsGameMode::startNewTurn for client " @ %client @ " team1List " @ %list @ " player at index 0 does not exist!");
}

function tacticsGameMode::resetPassiveTeamVars(%this, %list, %count)
{
   echo("\c4tacticsGameMode::resetPassiveTeamVars teamList " @ %list SPC %list.getName() @ " count " @ %count);
   
   if(!isObject(%list))
      error("scriptERROR tacticsGameMode::resetTeamVars team list does not exist!");
   else
   {
      for(%x=0; %x < %count; %x++)
      {
         %obj = %list.getKey(%x);
         if(!isObject(%obj))
            error("scriptERROR tacticsGameMode::resetPassiveTeamVars team list " @ %list @ " no playerObject at index " @ %x);
         else
         {
            echo("\c1tacticsGameMode::resetPassiveTeamVars " @ %obj SPC %obj.getName());
            %obj.clearAim();
            %obj.losGood = 0;
            %obj.shotThisTurn = 0;
            %obj.moveShootMode = 0;//move mode is 0, shoot mode is 1;
            %obj.turnComplete = 0;//only for Ai/CPU team
            %obj.setEnergyLevel(%obj.getDatablock().maxEnergy);//make sure they have recovered so they can move
            
            //reload
            %image = %obj.getMountedImage(0);//notice hardcoded imageSlot
            // Don't reload if the weapon's full.
            if (%obj.getInventory(%image.ammo) != %image.ammo.maxInventory)
               if (%image > 0)
                  %image.clearAmmoClip(%obj, 0);
         }
      }
   }
}


function tacticsGameMode::resetPassiveTeamAim(%this, %list, %count)
{
   //echo("tacticsGameMode::resetPassiveTeamAim teamList " @ %list SPC %list.getName() @ " count " @ %count);
   
   if(!isObject(%list))
      error("scriptERROR tacticsGameMode::resetTeamAim team list does not exist!");
   else
   {
      for(%x=0; %x < %count; %x++)
      {
         %obj = %list.getKey(%x);
         if(!isObject(%obj))
            error("scriptERROR tacticsGameMode::resetPassiveTeamAim team list " @ %list @ " no playerObject at index " @ %x);
         else
         {
            //echo("tacticsGameMode::resetPassiveTeamAim " @ %obj SPC %obj.getName());
            %obj.clearAim();
            %obj.losGood = 0;
         }
      }
   }
}
function tacticsGameMode::controlNextAiPlayer(%this, %list, %player)
{
   echo("\c4tacticsGameMode::controlNextAiPlayer teamList " @ %list @ " lastPlayer " @ %player);
   
   %this.activePlayer = 0;//reset
   %nextPlayer = 0;
   %count = %list.count();//array.count(); simgroup/simset.getCount();
   if(%count > 0)
   {
         //look down the list for anyone who has full energy 
         for(%x=0; %x < %count; %x++)
         {
            %testPlayer = %list.getKey(%x);
            
            if(isObject(%testPlayer) && %testPlayer != %player)
            {
               %complete = %testPlayer.turnComplete;
               echo("tacticsGameMode::controlNextAiPlayer player " @ %testPlayer @ " at index " @ %x @ " turnComplete " @ %complete);
               if(%complete != 1)
               {
                  %nextPlayer = %testPlayer;
                  break;
               }
            }
         }
   }

   if(isObject(%nextPlayer))
   {
      %this.activePlayer = %nextPlayer;
      %nextPlayer.activePlayerThink();
   }
   else
   {
      //clean up our troops and reset thier aiming
      if(%count > 0)
         %this.resetPassiveTeamVars(%list, %count);
      
      //give the player their turn, with little pause so it doesn't trip onwards too fast and let folks reload
      %playerTeam = team1List;
      %client = ClientGroup.getObject(0);//this is horrible and won't network at all but it is supposed to be singlePlayer
      %this.schedule(2000, "startNewTurn", %client, %playerTeam);
   }  
}
