function tacticsModule::onCreate(%this)
{
}

function tacticsModule::onDestroy(%this)
{
}

//This is called when the server is initially set up by the game application
function tacticsModule::initServer(%this)
{
    //--FILE EXEC BEGIN--
      %this.queueExec("./scripts/shared/tacticsGameMode");
      %this.queueExec("./scripts/server/tacticsCommands");
      
      %this.queueExec("./scripts/server/camera");
      %this.queueExec("./scripts/server/spawn");//must be after gameMode to overwrite $Game::DefaultCameraSpawnGroups and other game defaults
      
      %this.queueExec("./scripts/server/tacticsPlayerScripts");
      %this.queueExec("./scripts/server/tacticsTriggers");
    //--FILE EXEC END--
}

//This is called when the server is created for an actual game/map to be played
function tacticsModule::onCreateGameServer(%this)
{
    //--DATABLOCK EXEC BEGIN--
    //These are common managed data files. For any datablock-based stuff that gets generated by the editors
    //(that doesn't have a specific associated file, like data for a player class) will go into these.
    //So we'll register them now if they exist.
    %this.registerDatablock("./scripts/managedData/managedForestItemData");
    %this.registerDatablock("./scripts/managedData/managedForestBrushData");
    %this.registerDatablock("./scripts/managedData/managedParticleData");
    %this.registerDatablock("./scripts/managedData/managedParticleEmitterData");
    %this.registerDatablock("./scripts/managedData/managedDatablocks");
    //--DATABLOCK EXEC END--
    
    %this.registerDatablock("./scripts/managedData/managedDecalData");
    %this.registerDatablock("./datablocks/tacticsDatablocks");
}

//This is called when the server is shut down due to the game/map being exited
function tacticsModule::onDestroyGameServer(%this)
{
}

//This is called when the client is initially set up by the game application
function tacticsModule::initClient(%this)
{
    //--FILE EXEC BEGIN--
   %this.queueExec("./scripts/client/inputCommands");
    
    //client scripts
   %this.queueExec("./scripts/client/defaultkeybinds");
   %this.queueExec("./scripts/client/clientCommands");
   
   //messageCommands are not part of the noticeSystem
   %this.queueExec("./scripts/client/messageCommands");
        
   //gameMode must be exec'd for both server and client or else the client cannot select it for loading at the menu
   %this.queueExec("./scripts/shared/tacticsGameMode");

   //guis
   %this.queueExec("./guis/tacticsStartGui.gui");
   %this.queueExec("./guis/tacticsStartGui");
   %this.queueExec("./guis/tacticsOverlayGui.gui");
   %this.queueExec("./guis/tacticsOverlayGui");
   %this.queueExec("./guis/tacticsGameOverGui.gui");
   %this.queueExec("./guis/tacticsGameOverGui");
    //--FILE EXEC END--
}

//This is called when a client connects to a server
function tacticsModule::onCreateClientConnection(%this)
{
}

//This is called when a client disconnects from a server
function tacticsModule::onDestroyClientConnection(%this)
{
}
